{
  "family": "techstore-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::266077915547:role/LabRole",
  "taskRoleArn": "arn:aws:iam::266077915547:role/LabRole",
  "containerDefinitions": [
    {
      "name": "techstore-api",
      "image": "266077915547.dkr.ecr.us-east-1.amazonaws.com/techstore-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_DATASOURCE_URL", "value": "jdbc:h2:mem:techstore;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE" },
        { "name": "SPRING_DATASOURCE_USERNAME", "value": "sa" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "value": "admin123" },
        { "name": "SPRING_DATASOURCE_DRIVER_CLASS_NAME", "value": "org.h2.Driver" },
        { "name": "SPRING_JPA_DATABASE_PLATFORM", "value": "org.hibernate.dialect.H2Dialect" },
        { "name": "SPRING_JPA_HIBERNATE_DDL_AUTO", "value": "update" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "SQS_QUEUE_URL", "value": "https://sqs.us-east-1.amazonaws.com/266077915547/techstore-audit-queue" },
        { "name": "JWT_SECRET", "value": "TechStoreChile2024SecretKeyJWTSigningAlgorithmHS256Segura" },
        { "name": "APP_SECURITY_USERNAME", "value": "admin@techstore.cl" },
        { "name": "APP_SECURITY_PASSWORD", "value": "Admin1234" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/techstore-api-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
